# Copy to .env.production on the ECS and replace every CHANGE_ME value.
# Do not commit .env.production.
#
# PostgreSQL runs inside docker-compose.ecs.yml.
POSTGRES_USER=huangguanedu
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=huangguanedu

# IMPORTANT: if POSTGRES_PASSWORD contains URL-reserved characters, URL-encode it here.
DATABASE_URL=postgresql://huangguanedu:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/huangguanedu?sslmode=disable

# Public HTTPS origin handled by the existing host Nginx.
APP_BASE_URL=https://CHANGE_ME.example.com

# Generate independently, e.g. openssl rand -hex 32
SESSION_SECRET=CHANGE_ME
CRON_SECRET=CHANGE_ME

# Storage: private Alibaba Cloud OSS bucket in Shanghai.
STORAGE_PROVIDER=oss
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
# ali-oss Node.js SDK uses the OSS-specific region form.
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=CHANGE_ME
OSS_ACCESS_KEY_ID=CHANGE_ME
OSS_ACCESS_KEY_SECRET=CHANGE_ME
OSS_URL_EXPIRES_SECONDS=300

# Qwen / DashScope production mode.
QWEN_MODE=live
DASHSCOPE_API_KEY=CHANGE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
QWEN_IMAGE_TRANSPORT=object_storage
QWEN_MAX_PIXELS=4194304
QWEN_REQUEST_TIMEOUT_MS=30000
QWEN_MAX_RETRIES=2
QWEN_ENABLE_THINKING=false

# The host Nginx overwrites X-Forwarded-* headers and is the single trusted proxy hop.
TRUSTED_PROXY=true
TRUSTED_PROXY_HOPS=1

NEXT_PUBLIC_APP_NAME=黄冠AI Academy

# Optional database backup settings.
# ossutil 2.x uses the generic Alibaba Cloud region ID rather than ali-oss's oss-* form.
OSSUTIL_REGION=cn-shanghai
OSS_BACKUP_BUCKET=CHANGE_ME
OSS_BACKUP_PREFIX=backups/postgres
BACKUP_RETENTION_DAYS=7
