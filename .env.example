# 数据库连接（本地 Docker PostgreSQL / 测试 / 生产 RDS 统一使用）
# 本地示例：postgresql://huangguan:huangguan_dev@127.0.0.1:5432/huangguanedu
DATABASE_URL="postgresql://huangguan:huangguan_dev@127.0.0.1:5432/huangguanedu"

# 会话加密密钥：生产环境必须配置足够长的随机字符串；
# 会话令牌随机性不依赖该值（Cookie 存随机令牌、数据库存令牌哈希），
# 该密钥保留用于未来签名/加密场景，生产校验强制要求配置
SESSION_SECRET=

# 应用外部访问地址（QWEN_MODE=live 时用于生成 Qwen 可访问的图片 URL；生产必须配置）
APP_BASE_URL=

# 会话 Cookie 名称（可选，默认 yy_session）
SESSION_COOKIE_NAME=yy_session

# CSRF Cookie 名称（可选，默认 yy_csrf；双提交 Cookie 模式，前端需回传 X-CSRF-Token 头）
CSRF_COOKIE_NAME=yy_csrf

# Qwen 接口模式：mock 为本地模拟（无需 Key），live 为真实调用（必须配置 Key 与 Base URL）
QWEN_MODE=mock

# 阿里云百炼 DashScope API Key（live 模式必填，严禁进入前端或日志）
DASHSCOPE_API_KEY=

# DashScope OpenAI 兼容接口地址（北京地域）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Qwen 视觉理解模型
DASHSCOPE_MODEL=qwen3.7-plus

# 图片传输方式：object_storage 使用短期签名 URL（生产 OSS/S3）
QWEN_IMAGE_TRANSPORT=object_storage

# 图片最大像素数
QWEN_MAX_PIXELS=4194304

# Qwen 请求超时（毫秒）
QWEN_REQUEST_TIMEOUT_MS=30000

# Qwen 请求最大重试次数
QWEN_MAX_RETRIES=2

# 是否启用思考模式
QWEN_ENABLE_THINKING=false

# 内部清理接口的调用密钥（生产必须配置，由外部 cron 携带调用）
CRON_SECRET=

# 文件存储提供方：local（本地目录）或 oss（阿里云 OSS 私有 Bucket）
STORAGE_PROVIDER=local

# 阿里云 OSS（STORAGE_PROVIDER=oss 时必须配置；AccessKey 严禁进入前端/数据库/日志）
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_URL_EXPIRES_SECONDS=300

# 可信代理：仅当部署在 Nginx/负载均衡之后且由代理覆盖 X-Forwarded-* 头时设为 true
TRUSTED_PROXY=false
TRUSTED_PROXY_HOPS=1

# 应用名称
NEXT_PUBLIC_APP_NAME=黄冠AI Academy
